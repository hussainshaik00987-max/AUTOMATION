# Normalise line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

*.png binary
*.jpg binary
*.mp4 binary
*.ttf binary
*.woff  binary
*.woff2 binary
*.exe binary

# Keep generated lockfiles and vendored data out of diffs and language stats.
package-lock.json  linguist-generated=true -diff
go.sum             linguist-generated=true -diff
docs/media/**      linguist-documentation=true
