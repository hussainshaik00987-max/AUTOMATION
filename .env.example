# Coldwire Local Business Lead Automation Platform - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to Git!

# ── Telegram Lead Review Bot ──────────────────────────────────────────────
# Obtain your Bot Token from @BotFather on Telegram (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram User ID (obtain from @userinfobot or @raw_data_bot)
# Only this user can interact with the review bot. Group chats are rejected.
AUTHORIZED_USER_ID=123456789

# ── Database ─────────────────────────────────────────────────────────────
# Local filesystem path for the SQLite database (must not be on a network mount)
# Defaults to ~/.local/share/coldcall/leads.db if left unset
# COLDCALL_DB=C:\Users\username\.local\share\coldcall\leads.db
