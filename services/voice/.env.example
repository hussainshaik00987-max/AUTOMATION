# =============================================================================
# Coldwire · voice — configuration
#
# Copy to `.env` and fill in. Nothing here has a safe default that can dial a
# phone, so an unconfigured checkout cannot cost money or reach a stranger.
# =============================================================================

# ── Webhook server ───────────────────────────────────────────────────────────
# The carrier posts call events here and opens the media WebSocket here. In
# development this is a tunnel; in production it is a TLS vhost you control.
PORT=8081
PUBLIC_HOST=voice.example.com
WEBHOOK_URL=https://voice.example.com/webhook
STREAM_URL=wss://voice.example.com/media-stream

# ── Telephony (Telnyx Call Control v2) ───────────────────────────────────────
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
FROM_NUMBER=+15550000000

# Media anchor site. This is the single largest lever on per-turn latency: the
# anchor sits between the handset and this server, and picking the wrong one
# routes every turn across an ocean and back. `Latency` auto-selects by RTT to
# the connection, which is not the same thing as RTT along the actual path.
# Measured: a US anchor added ~1.6s per turn to a Europe-hosted, India-dialling
# campaign. See docs/engineering-log.md#latency.
TELNYX_ANCHORSITE=Amsterdam

# Open the media socket while the phone is still RINGING rather than on answer.
# Saves ~1s at the worst possible moment — see docs/engineering-log.md.
STREAM_BEFORE_DIAL=true

# Ring timeout. The carrier default is 30s; on a long international route the
# answer signal arrives late and a 30s timer silently cancels calls people have
# already picked up. 90s clears the measured distribution with headroom.
RING_TIMEOUT=90s

# ── Brain: OpenAI Realtime (audio in, TEXT out) ──────────────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# Prospect-side ASR language. MUST match the campaign language: left at "en"
# for a non-English campaign, transcription returns confident nonsense and every
# downstream heuristic that reads the transcript silently breaks.
TRANSCRIBE_LANGUAGE=hi
VAD_MODE=server_vad
REASONING_EFFORT=minimal

# ── Voice: ElevenLabs (everything the prospect hears, in ulaw_8000) ──────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_SPEED=

# Opening line style. `confirm` plays the pre-synthesised personal opener.
OPENER_STYLE=confirm
# How many leads ahead to pre-synthesise openers for, inside the previous
# call's runtime. Time-to-first-audio is ~0 instead of 1.5-3.5s.
OPENER_LOOKAHEAD=3

# ── Campaign ─────────────────────────────────────────────────────────────────
PROSPECTS_FILE=data/sample_leads.csv
RESULTS_FILE=results.csv
# How a bare national-format number is parsed. It CANNOT be inferred from the
# digits — many countries' mobile ranges overlap — so it is explicit.
DEFAULT_REGION=IN
CALL_TIMEOUT=180s
DELAY_BETWEEN=8s
MEETING_TIMEZONE=Asia/Kolkata

# ── Follow-up handoff ────────────────────────────────────────────────────────
# The messaging sidecar owns every promise made on a call. The agent refuses to
# dial if it is not linked: a "yes, send it" against a dead sidecar is a promise
# to a real person that silently never lands.
WHATSAPP_API=http://127.0.0.1:8082
PENDING_EMAILS_FILE=pending_emails.csv
FAILED_LINKS_FILE=failed_links.csv
SUPPRESSION_FILE=suppression.csv

# ── Recording & logging ──────────────────────────────────────────────────────
# Recording obligations are jurisdiction-specific. Read docs/compliance.md
# before enabling this against real numbers.
RECORD_CALLS=false
RECORDINGS_DIR=recordings
LOG_LEVEL=info

# ── Inbound audio floors ─────────────────────────────────────────────────────
# What counts as "the prospect is talking" (speech) and "the prospect is
# interrupting" (barge-in), in linear-PCM amplitude.
#
# These are ROUTE-SPECIFIC and must be measured, never inherited. Every call
# logs an `inbound loudness histogram`; tune from that. A real measurement from
# one route, 5,027 frames:
#
#     0-99 = 4211   100-299 = 483   300-599 = 155
#     600-999 = 78  1000-1999 = 95  2000+ = 5
#
# The prospect's speech lived in the 100-299 band — below the inherited 250
# floor — so his "hello" registered as 0ms of speech and the agent waited out a
# timer instead of answering him. Leave blank to use the shipped defaults.
SPEECH_ENERGY_THRESHOLD=
BARGE_IN_THRESHOLD=
