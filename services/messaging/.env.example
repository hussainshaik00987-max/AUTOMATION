# WhatsApp follow-up sidecar

# HTTP port the Go agent posts leads to. Must match WHATSAPP_API in ../voice/.env
PORT=8082

# Reply classification (see intent.js). Without a key the keyword pass still
# handles the short "haan"/"nahi" replies that make up most traffic.
OPENAI_API_KEY=
OPENAI_INTENT_MODEL=gpt-5-nano

# How long to wait after the "link bhej doon?" ping before sending the link
# anyway. Randomised per lead inside this window.
WAIT_MIN_MINUTES=30
WAIT_MAX_MINUTES=40

# ── Behaving like a person (human.js) ───────────────────────────────────────
# Content variety only solves half the problem. An account that has never looked
# anybody up, never gone online, never read a message, and sends everything with
# a two-second typing indicator at 3am is describable in one heuristic no matter
# how the text reads. These are the knobs for the other half.

# Getting-started pause before the typing indicator appears, then the speed it
# is held at. 13 chars/sec is a fast thumb-typist; URLs in the text are not
# counted, because nobody types a URL. The cap stops a long link message from
# holding "typing…" for a minute and a half.
TYPING_MIN_MS=2500
TYPING_MAX_MS=5000
TYPING_CPS=13
TYPING_CAP_MS=26000
# The stop-and-think mid-message. One or two per longer message.
TYPING_PAUSE_MIN_MS=900
TYPING_PAUSE_MAX_MS=2800

# Dwell between opening the chat and starting to type.
READ_DELAY_MIN_MS=1500
READ_DELAY_MAX_MS=5000

# Gap between the two bubbles of a split message.
BUBBLE_GAP_MIN_MS=900
BUBBLE_GAP_MAX_MS=2600

# How often a message arrives as two bubbles rather than one — a greeting sent,
# then the rest typed after it. The ping is the FIRST message to a cold number,
# and two cold messages in a row is a worse shape than one, so it splits less.
# Set either to 0 to always send one message.
SPLIT_RATE_PING=0.25
SPLIT_RATE_LINK=0.4

# How often opening a chat also loads the contact's display picture, and how
# often that goes further into their status text and business card. Worth
# something to us too: a business profile carries the website field, and it is
# recorded on the job when it is there.
PROFILE_PEEK_RATE=0.7
PROFILE_DEEP_RATE=0.35

# How long a reply sits before it is answered. Nobody replies to WhatsApp in
# under a second.
REPLY_DELAY_MIN_MS=20000
REPLY_DELAY_MAX_MS=150000

# Sending window, wall-clock in the campaign's timezone. A message at 03:40 is
# the loudest bot tell there is and the fastest way to be reported by somebody
# whose phone woke them up. Times are computed from TZ_OFFSET_MINUTES (330 =
# IST), not the server's TZ, because the box runs on UTC.
#
# Only PROACTIVE sends are held. A lead who messages US outside the window still
# gets an answer, within QUIET_REPLY_GRACE_MINUTES either side — if they write at
# 22:30 they are plainly awake, and a person would reply.
SEND_WINDOW=true
SEND_WINDOW_START=09:30
SEND_WINDOW_END=21:30
QUIET_REPLY_GRACE_MINUTES=90
TZ_OFFSET_MINUTES=330

# Outbound pacing. These are anti-ban settings, not throughput settings —
# read the README before raising them.
SEND_GAP_MIN_MS=8000
SEND_GAP_MAX_MS=20000
DAILY_SEND_CAP=250

# Rehearsal mode: route EVERY message to this number instead of the real lead,
# so you can watch the whole flow land on your own phone. Leave empty for live.
# TEST_NUMBER=+919999999999

LOG_LEVEL=info
